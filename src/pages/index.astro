---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Link in Bio — Nuovotaka Link in Bio.',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <!-- Hero Widget ******************* -->

  <Hero title="Link 一覧" image={{ src: '~/assets/images/hero-image.jpeg', alt: 'Nuovotaka Link in BIO Hero Image' }} />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="自作キーボードSHOP"
    actions={[
      {
        variant: 'primary',
        text: 'nuovotaka-kbd',
        href: 'https://nuovotaka-kbd.stores.jp',
        icon: 'tabler:shopping-bag',
      },
    ]}
  />
  <CallToAction
    title="レザークラフトSHOP"
    actions={[
      {
        variant: 'primary',
        text: 'NUOVOTAKA Leather Craft',
        href: 'https://nuovotaka-leather.stores.jp',
        icon: 'tabler:shopping-bag',
      },
    ]}
  />
  <CallToAction
    title="WebSite"
    actions={[
      {
        variant: 'primary',
        text: 'nuovotaka',
        href: 'https://www.nuovotaka.com',
        icon: 'tabler:home',
      },
    ]}
  />
  <CallToAction
    title="X"
    actions={[
      {
        variant: 'primary',
        text: 'nuovotaka',
        href: 'https://x.com/nuovotaka',
        icon: 'tabler:brand-x',
      },
    ]}
  />
  <CallToAction
    title="YouTube"
    actions={[
      {
        variant: 'primary',
        text: 'nuovotakaTV',
        href: 'https://www.youtube.com/@nuovotakatv',
        icon: 'tabler:brand-youtube',
      },
    ]}
  />
  <CallToAction
    title="Instagram"
    actions={[
      {
        variant: 'primary',
        text: 'Takahiro_723',
        href: 'https://www.instagram.com/takahiro_723/',
        icon: 'tabler:brand-instagram',
      },
    ]}
  />
  <CallToAction
    title="GitHub"
    actions={[
      {
        variant: 'primary',
        text: 'nuovotaka',
        href: 'https://github.com/nuovotaka',
        icon: 'tabler:brand-github',
      },
    ]}
  />
</Layout>
